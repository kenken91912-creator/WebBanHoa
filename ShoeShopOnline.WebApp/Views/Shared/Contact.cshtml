@model IEnumerable<ShoeShopOnline.Model.DAL.Contact>
@{
    int i = 0;
}

<div class="footer" id="Contact">
    <div class="container">
        <div class="footer-top">
            @if (ViewBag.Count > 0)
            {
                foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <h3>@item.Title</h3>
                        <ul>
                            <li><b>@item.ObjectName</b></li>
                            <li>Địa chỉ: <a href="#">@item.Address</a></li>
                            <li>Sđt: <a href="#">@item.Mobile</a></li>
                            <li>Website: <a href="#">@item.Website</a></li>
                            <li>Email: <a href="#">@item.Email</a></li>
                        </ul>
                    </div>
                }
                <div class="col-md-4">
                    <h3>Bản Đồ</h3>
                    <ul>
                        <iframe src="https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d3918.391276591812!2d106.77222977355311!3d10.857815357690239!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1zNjgvOSDEkMaw4budbmcgOCBLaHUgcGjhu5EgMyBMaW5oIFh1w6JuIFRo4bunIMSQ4bupYw!5e0!3m2!1svi!2s!4v1729415845578!5m2!1svi!2s" width="300" height="200" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </ul>
                </div>
            }
            <div class="clearfix"> </div>
        </div>
    </div>
</div>