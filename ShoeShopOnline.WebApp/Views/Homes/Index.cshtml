
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--banner-starts-->
@{ Html.RenderAction("Slide", "Homes");}
<!--banner-ends-->
<!--Slider-Starts-Here-->
<script src="~/Content/Client/js/responsiveslides.min.js"></script>
<script>
    // You can also use "$(window).load(function() {"
    $(function () {
        // Slideshow 4
        $("#slider4").responsiveSlides({
            auto: true,
            pager: true,
            nav: false,
            speed: 500,
            namespace: "callbacks",
            before: function () {
                $('.events').append("<li>before event fired.</li>");
            },
            after: function () {
                $('.events').append("<li>after event fired.</li>");
            }
        });

    });
</script>
<!--End-slider-script-->
<!--start-banner-bottom-->

@{Html.RenderAction("LoadHotProduct", "Product");}
<!--end-banner-bottom-->
<!--start-shoes-->
<div class="shoes">
    <div class="container">
        <div class="product-one">
            @{ Html.RenderAction("LoadNormalProduct1", "Product");}
            <div class="clearfix"> </div>
        </div>
        <div class="product-one">
            @{ Html.RenderAction("LoadNormalProduct2", "Product");}
            <div class="clearfix"> </div>
        </div>
    </div>
</div>
<!--end-shoes-->
<!--start-abt-shoe-->
<div class="product-section-fix" style="padding: 40px 0; background: #fff;">
    
    <div style="text-align: center; margin-bottom: 40px;">
        <h3 style="font-size: 28px; font-weight: bold; text-transform: uppercase; margin: 0; color: #333;">
            SẢN PHẨM MỚI
        </h3>
        <div style="width: 60px; height: 4px; background: #ff4d6d; margin: 10px auto;"></div>
    </div>

    <div class="container">
        <div class="force-grid-layout">
            @{Html.RenderAction("LoadNewProduct", "Product");}
        </div>
    </div>

    <style>
        /* Reset container chính */
        .force-grid-layout {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)) !important;
            gap: 30px !important;
            width: 100% !important;
            float: none !important;
        }

        /* XỬ LÝ CÁC ITEM CON (Card sản phẩm) */
        /* Chọn tất cả thẻ div trực tiếp bên trong RenderAction */
        .force-grid-layout > div, 
        .abt-shoe-left, 
        .product-main {
            /* Reset vị trí để không bị chồng chéo */
            position: relative !important; 
            top: auto !important; 
            left: auto !important; 
            right: auto !important; 
            bottom: auto !important;
            float: none !important;
            
            /* Reset kích thước */
            width: 100% !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            
            /* Style giao diện card */
            background: #fff !important;
            border: 1px solid #e1e1e1 !important;
            border-radius: 8px !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05) !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important; /* Cắt bỏ phần thừa */
        }

        /* Xử lý ẢNH: Bắt buộc ảnh phải nằm gọn */
        .force-grid-layout img {
            width: 100% !important;
            height: 220px !important; /* Chiều cao cố định cho ảnh đẹp */
            object-fit: cover !important; /* Cắt ảnh vừa khung, không méo */
            display: block !important;
            position: static !important; /* Bỏ absolute nếu có */
        }

        /* Xử lý TIÊU ĐỀ SẢN PHẨM */
        .force-grid-layout h4 {
            font-size: 16px !important;
            font-weight: 700 !important;
            color: #333 !important;
            margin: 15px 10px 5px !important;
            text-align: center !important;
            line-height: 1.4 !important;
            
            /* Giới hạn 2 dòng để đều nhau */
            height: 44px !important;
            overflow: hidden !important;
            display: -webkit-box !important;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* Xử lý MÔ TẢ/GIÁ/TEXT KHÁC */
        .force-grid-layout p, 
        .force-grid-layout .content {
            font-size: 14px !important;
            color: #666 !important;
            padding: 0 10px !important;
            margin-bottom: 15px !important;
            text-align: center !important;
            
            /* Tự đẩy nút xuống đáy */
            flex-grow: 1 !important; 
        }

        /* Xử lý NÚT BẤM */
        .force-grid-layout a {
            display: block !important;
            width: fit-content !important;
            margin: 0 auto 20px !important; /* Canh giữa và cách đáy */
            padding: 8px 20px !important;
            background-color: #ff4d6d !important;
            color: white !important;
            border-radius: 20px !important;
            text-decoration: none !important;
            font-weight: bold !important;
            font-size: 13px !important;
            position: relative !important; /* Đảm bảo nút nổi lên trên */
            z-index: 10 !important;
        }

        /* Ẩn các thành phần rác gây lỗi */
        .clearfix, .clear { display: none !important; }
    </style>
</div>
<!--end-abt-shoe-->